rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Accounts ──────────────────────────────────────────────────────────────
    // Only the authenticated owner can read/write their own account document.
    match /accounts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Patient links subcollection: only the account owner can manage.
      match /patientLinks/{linkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Patients ──────────────────────────────────────────────────────────────
    // Only the ownerUid can read/update their own patient records.
    // Doctors can read patient profiles.
    match /patients/{patientId} {
      function isDoctor() {
        return request.auth != null; // TEMPORARY FOR MOCK AUTH
      }

      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid || isDoctor());
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid || isDoctor());
      // Patients cannot be deleted — healthcare records must be preserved.
      allow delete: if false;

      // ── Medical Records Subcollection ───────────────────────────────────
      // Only the authenticated owner of the parent patient profile can read/write records.
      match /medicalRecords/{recordId} {
        function isPatientOwner() {
          return request.auth != null &&
            get(/databases/$(database)/documents/patients/$(patientId)).data.ownerUid == request.auth.uid;
        }

        allow read: if isPatientOwner() || isDoctor();
        allow create: if (isPatientOwner() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.patientId == patientId)
                      || (isDoctor() && request.resource.data.patientId == patientId);
        allow update: if (isPatientOwner() && request.resource.data.ownerUid == request.auth.uid) || isDoctor();
        allow delete: if isPatientOwner();
      }
    }

    // ── Appointments ──────────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      function isDoctor() {
        return request.auth != null; // TEMPORARY FOR MOCK AUTH
      }
      // Only doctors can manage appointments for now
      allow read, write: if isDoctor();
    }

    // ── Patient QR Codes ──────────────────────────────────────────────────────
    match /patientQrCodes/{token} {
      // Patients need to generate their own QR codes, Doctors need to read them to verify
      allow read, write: if request.auth != null;
    }

    // ── Default Deny ──────────────────────────────────────────────────────────
    // All other paths are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
