rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Accounts ──────────────────────────────────────────────────────────────
    // Only the authenticated owner can read/write their own account document.
    match /accounts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Patient links subcollection: only the account owner can manage.
      match /patientLinks/{linkId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Patients ──────────────────────────────────────────────────────────────
    // Only the ownerUid can read/update their own patient records.
    // TODO: Future phases will add role-based access for ASHA, Doctor, Hospital Admin.
    match /patients/{patientId} {
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
      // Patients cannot be deleted — healthcare records must be preserved.
      allow delete: if false;
    }

    // ── Default Deny ──────────────────────────────────────────────────────────
    // All other paths are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
